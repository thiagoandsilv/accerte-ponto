# URL de conexão do Postgres. No Render, use o "Internal Database URL"
# do banco Postgres que você criar (Render preenche isso automaticamente
# se o banco estiver vinculado ao Web Service).
DATABASE_URL=postgresql://usuario:senha@localhost:5432/ponto_certo

# Porta do servidor. O Render define isso sozinho — só é preciso localmente.
PORT=3000
